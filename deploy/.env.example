REGISTRY=
TAG=latest

# ---- 网关对外端口（服务器的 80 被占用时才需要改）----
HTTP_PORT=80
HTTPS_PORT=443

# ---- 数据库（首次启动自动建库建表 + 种子数据，账号 admin/admin123）----
MYSQL_ROOT_PASSWORD=
DB_USER=xavierblog
DB_PASSWORD=
DB_NAME=xavierblog

# ---- 数据库对外端口（Navicat 连接用）----
# DB_PUBLIC_HOST 填 0.0.0.0 表示监听所有网卡；生产建议改成 127.0.0.1，
# 然后用 SSH 隧道（ssh -L 3306:127.0.0.1:3306 user@服务器IP）连接，安全性最高
DB_PUBLIC_HOST=0.0.0.0
DB_PUBLIC_PORT=3306

# ---- JWT 签名密钥，生成方式：openssl rand -hex 32 ----
SECRET_KEY=
