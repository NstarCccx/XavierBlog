# ===== 应用 =====
APP_NAME=XavierBlog API
DEBUG=true

# ===== 安全 =====
# JWT 签名密钥，生产环境务必换成随机长字符串，例如：openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret
# Token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== 数据库（本地 MySQL）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=xavierblog
